# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NUNCA se sube al repositorio (.gitignore).

# Modo depuración: True en desarrollo, False en producción
DEBUG=True

# Clave secreta de Django (generar una nueva por entorno)
SECRET_KEY=

# URL de la base de datos (vacío = SQLite local; en hosting = PostgreSQL)
DATABASE_URL=

# Credenciales del servicio de email (Resend/Gmail SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
